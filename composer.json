{
	"name" : "goodmagma/laravel-translations",
	"description" : "Export Localization strings and translate it via Google Translate for Laravel",
	"keywords" : [
		"laravel",
		"translations",
		"translation",
		"export",
		"exporter",
		"json",
		"localization"
	],
	"license" : "MIT",
	"authors" : [{
			"name" : "Denis Torresan",
			"email" : "denis.torresan@gmail.com"
		}
	],
	"require" : {
		"php" : "^8.2",
		"ext-json" : "*",
		"illuminate/support" : "^11.0|^12.0",
		"illuminate/translation" : "^11.0|^12.0",
		"stichoza/google-translate-php" : "^5.2",
		"symfony/finder" : "^7.2"
	},
	"require-dev" : {
		"larastan/larastan" : "^3.0",
		"orchestra/testbench" : "^10.0",
		"phpunit/phpunit" : "^11.5|^12.0"
	},
	"autoload" : {
		"psr-4" : {
			"Goodmagma\\Translations\\" : "src/"
		}
	},
	"autoload-dev" : {
		"psr-4" : {
			"Tests\\" : "tests/"
		}
	},
	"extra" : {
		"laravel" : {
			"providers" : [
				"Goodmagma\\Translations\\TranslationsServiceProvider"
			]
		}
	},
	"config" : {
		"sort-packages" : true
	},
	"minimum-stability" : "stable"
}